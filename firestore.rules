rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{collection}/{reportId} {
      allow read: if owns(uid) && collection in ['riskReports', 'floorReports'];
      allow create, update: if owns(uid)
        && collection in ['riskReports', 'floorReports']
        && request.resource.data.ownerId == uid
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.createdAt is timestamp;
      allow delete: if owns(uid) && collection in ['riskReports', 'floorReports'];
    }
  }
}
